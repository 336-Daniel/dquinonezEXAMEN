<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dquinonezEXAMEN.Views.Resumen"
             Title="Resumen">
    <VerticalStackLayout Spacing="15" Margin="20">

        <Label x:Name="lblUsuario" 
               FontAttributes="Bold" />

        <Label Text="RESUMEN" 
               FontSize="22" 
               HorizontalOptions="Center" 
               FontAttributes="Bold" />

        <Grid RowSpacing="10" ColumnSpacing="15" HorizontalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Text="Nombre:" Grid.Row="0" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblNombre" 
                   Grid.Row="0" 
                   Grid.Column="1" />

            <Label Text="Apellido:"
                   Grid.Row="1" Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblApellido" 
                   Grid.Row="1" 
                   Grid.Column="1" />

            <Label Text="Edad:" 
                   Grid.Row="2" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblEdad" 
                   Grid.Row="2" 
                   Grid.Column="1" />

            <Label Text="Fecha de inicio:"
                   Grid.Row="3" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblFecha" 
                   Grid.Row="3" 
                   Grid.Column="1" />

            <Label Text="Plan:" 
                   Grid.Row="4" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblPlan" 
                   Grid.Row="4" 
                   Grid.Column="1" />

            <Label Text="Casillero:" 
                   Grid.Row="5" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblCasillero" 
                   Grid.Row="5" 
                   Grid.Column="1" />

            <Label Text="Monto Inicial:" 
                   Grid.Row="6" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblMontoInicial" 
                   Grid.Row="6" 
                   Grid.Column="1" />

            <Label Text="Pago Mensual:" 
                   Grid.Row="7" 
                   Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblPagoMensual" 
                   Grid.Row="7" 
                   Grid.Column="1" />

            <Label Text="Pago Total:" 
                   Grid.Row="8" Grid.Column="0" 
                   FontAttributes="Bold"/>
            <Label x:Name="lblPagoTotal" 
                   Grid.Row="8" 
                   Grid.Column="1" />
        </Grid>

        <Button x:Name="btnNuevoRegistro" 
                Text="Nuevo registro" 
                Clicked="btnNuevoRegistro_Clicked" 
                />
        <Button x:Name="btnCerrarSesion"
                Text="Cerrar sesión" 
                Clicked="btnCerrarSesion_Clicked" />
        <Button x:Name="btnExportar"
                Text="Exportar a TXT" 
                Clicked="btnExportar_Clicked"/>

    </VerticalStackLayout>
</ContentPage>